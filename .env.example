NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Local only. Use .env.local for real values.
# OAuth ADC is usually /Users/<you>/.config/gcloud/application_default_credentials.json.
# Service accounts can point to the downloaded service account JSON key.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-credentials.json
GA4_PROPERTY_ID=123456789
